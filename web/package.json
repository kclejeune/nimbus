{
	"name": "nimbus-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:worker": "wrangler dev --port 8788 --host localhost:8788 $(test -f wrangler.local.jsonc && echo --config=wrangler.local.jsonc)",
		"build": "wireit",
		"preview": "vite preview",
		"migrate": "wireit",
		"migrate:local": "node scripts/migrate.mjs --local",
		"deploy": "wireit",
		"deploy:preview": "wireit",
		"deploy:worker": "wireit",
		"deploy:waf": "wireit",
		"set-hostnames": "node scripts/set-hostnames.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wireit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "wireit"
	},
	"wireit": {
		"build": {
			"command": "vite build",
			"files": [
				"src/**",
				"static/**",
				"vite.config.ts",
				"tsconfig.json",
				"wrangler.adapter.jsonc"
			],
			"output": [
				".svelte-kit/output/**",
				".svelte-kit/cloudflare/**"
			]
		},
		"config": {
			"command": "node scripts/materialize-config.mjs"
		},
		"migrate": {
			"command": "node scripts/migrate.mjs",
			"dependencies": [
				"config"
			]
		},
		"deploy:worker": {
			"command": "wrangler deploy $(test -f wrangler.local.jsonc && echo --config=wrangler.local.jsonc)",
			"dependencies": [
				"build",
				"migrate",
				"config"
			]
		},
		"deploy:preview": {
			"command": "wrangler versions upload $(test -f wrangler.local.jsonc && echo --config=wrangler.local.jsonc)",
			"dependencies": [
				"build",
				"config"
			]
		},
		"deploy:waf": {
			"command": "if command -v fnox >/dev/null 2>&1; then fnox exec -- node scripts/deploy-waf.mjs --optional; else node scripts/deploy-waf.mjs --optional; fi",
			"dependencies": [
				"config"
			]
		},
		"deploy": {
			"dependencies": [
				"deploy:worker",
				"deploy:waf"
			]
		},
		"check": {
			"command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
			"files": [
				"src/**",
				"static/**",
				"vite.config.ts",
				"tsconfig.json"
			],
			"output": []
		},
		"test": {
			"command": "vitest run",
			"files": [
				"src/**",
				"vite.config.ts",
				"vitest.config.ts",
				"tsconfig.json"
			],
			"output": []
		}
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260926.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-cloudflare": "^7.2.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.3",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-kit": "^0.31.11",
		"layerchart": "^2.5.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"wireit": "^0.14.13",
		"wrangler": "^4.141.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		}
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"esbuild@0.25.12": true,
		"fsevents@2.3.3": true,
		"workerd@1.20260801.1": true
	},
	"dependencies": {
		"better-auth": "^1.7.6",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"jose": "^6.2.12",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"cloudflare": {
		"bindings": {
			"ATTIC_DB": {
				"description": "D1 database for cache/NAR metadata and admin tables (schema descends from attic's)."
			},
			"CACHE_BUCKET": {
				"description": "R2 bucket holding deduplicated NAR chunks."
			},
			"CACHE_METRICS": {
				"description": "Analytics Engine dataset for the monitoring page's traffic metrics."
			}
		}
	}
}
